# Local PostgreSQL/PostGIS and Redis are provided by infra/docker-compose.yml.
ConnectionStrings__Fgp=Host=localhost;Port=5433;Database=postgres;Username=postgres;Password=postgres
FGP_API_ORIGIN=http://127.0.0.1:8080
Worker__BaseUrl=http://127.0.0.1:8000
Worker__ServiceToken=replace-with-a-long-random-service-token
Redis__ConnectionString=localhost:6380
Email__SmtpHost=localhost
Email__SmtpPort=1025
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPTILER_KEY=
TARIFF_YEAR=2026

# Seed/import gates. Keep these unset unless explicitly approved.
TARGET_DATABASE_URL=
SEED_ORGANIZATION_ID=
SOURCE_DATABASE_URL=
SOURCE_CLASSIFICATION_PATH=
IMPORT_MAPPING_PATH=
