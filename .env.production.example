# Reachable production services only. Do not use localhost or 127.0.0.1 here.
# Deployment and cloud provisioning remain explicit owner gates — see README.md.

# ASP.NET Core API
ConnectionStrings__Fgp=Host=YOUR_DB_HOST;Port=5432;Database=fgp;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require
Worker__BaseUrl=https://YOUR_WORKER_HOST
Worker__ServiceToken=replace-with-a-long-random-service-token
Redis__ConnectionString=YOUR_REDIS_HOST:6379
Email__SmtpHost=YOUR_SMTP_HOST
Email__SmtpPort=587
Web__PublicOrigin=https://YOUR_SITE_HOST

# Generated compliance PDFs. Local disk by default; the Azure Blob adapter is
# part of the owner-gated deployment work.
Artifacts__StoragePath=/var/lib/fgp/artifacts

# Next.js web
FGP_API_ORIGIN=https://YOUR_API_HOST
NEXT_PUBLIC_SITE_URL=https://YOUR_SITE_HOST
NEXT_PUBLIC_MAPTILER_KEY=
TARIFF_YEAR=2026
