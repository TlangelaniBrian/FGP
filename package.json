{
  "name": "first-gen-properties",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web run build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web run typecheck",
    "test:web": "pnpm --filter web run test --run",
    "test:api": "./scripts/run-api-tests.sh",
    "test:worker": "cd apps/worker && uv run --extra dev pytest",
    "test:security-regression": "node scripts/security-regression-smoke.mjs",
    "acceptance": "bash scripts/acceptance/run-acceptance.sh"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devDependencies": {}
}
